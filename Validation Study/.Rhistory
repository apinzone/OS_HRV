#Load Required Packages
library(readxl)
library(ggplot2)
library(lme4)
library(performance)
library(arm)
library(car)
library(dplyr)
library(parameters)
library(effectsize)
library(chisq.posthoc.test)
library(emmeans)
library(ggeffects)
#Open Correct Excel File
df_era <- read_excel("C:/Users/Anthony/Desktop/R/NBA_ALL_ERAS.xlsm", sheet = 1)
# Era as factor
df_era$ERA_REG <- factor(df_era$ERA_REG,
levels = 0:1,
labels = c("MID", "NEW"))
# RRI category as factor
df_era$RRI_CAT <- factor(df_era$RRI_CAT,
levels = 0:4,
labels = c("CAT 0", "CAT 1", "CAT 2", "CAT 3", "CAT 4"))
df_era$WL <- factor(df_era$WL,
levels = 1:2,
labels = c("WIN", "LOSS"))
#GameID as factor
df_era$GameID <- factor(df_era$GameID)
# Confirm  factor structure
levels(df_era$ERA_REG)
levels(df_era$RRI_CAT)
levels(df_era$WL)
#DESCRIPTIVES
#REST INTEVAL
df_era %>%
group_by(ERA_REG, WL) %>%
summarise(
n = n(),
mean = mean(Rest_Interval),
sd = sd(Rest_Interval),
sem = sd / sqrt(n),
.groups = "drop"
)
RI_ANOVA <- aov(Rest_Interval ~ ERA_REG * WL, data = df_era)
summary(RI_ANOVA)
eta_squared(RI_ANOVA, partial = TRUE)
#MAIN EFFECT OF ERA AND WL no INT
#RRI
#DIFF
df_era %>%
group_by(ERA_REG, WL) %>%
summarise(
n = n(),
mean = mean(DIFF),
sd = sd(DIFF),
sem = sd / sqrt(n),
.groups = "drop"
)
DIFF_ANOVA <- aov(DIFF ~ ERA_REG * WL, data = df_era)
eta_squared(DIFF_ANOVA, partial = TRUE)
emm_diff <- emmeans(DIFF_ANOVA, pairwise ~ ERA_REG * WL)
eff_size(emm_diff, sigma = sigma(DIFF_ANOVA), edf = df.residual(DIFF_ANOVA))
#PF
#PA
#Assumption
#MODEL COLLINEARITY DIAGNOSTICS for IVS
vif(model_interaction_diff_era)
#LINEARITY FOR LINEAR MODELS (ONLY CONTINUOUS IV IS OPP W/L)
crPlots(lm(DIFF ~ Mean_Centered_OPP_WL, data = df_era))
title("Linearity Check for DIFF")
crPlots(lm(PA ~ Mean_Centered_OPP_WL, data = df_era))
title("Linearity Check for PA")
crPlots(lm(PF ~ Mean_Centered_OPP_WL, data = df_era))
title("Linearity Check for PF")
#LINEARITY OF LOGIT, cannot use box tidwell because of mean_centered WL values, looking for randomness
binnedplot(fitted(model_interaction_diff_era), resid(model_interaction_diff_era,type = "pearson"))
#Descriptives
#Model for ERA * RRI Interaction and all predictors
model_interaction_diff_era <- lmer( #DIFF MODEL
DIFF ~ ERA_REG * RRI_CAT +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df_era)
null_model_diff_era <- lmer(DIFF ~ 1 + (1 | GameID), data = df_era)
model_interaction_pf_era <- lmer( #PF MODEL
PF ~ ERA_REG * RRI_CAT +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df_era)
null_model_pf_era <- lmer(PF ~ 1 + (1 | GameID), data = df_era)
model_interaction_pa_era <- lmer( #PA MODEL
PA ~ ERA_REG * RRI_CAT +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df_era)
null_model_pa_era <- lmer(PA ~ 1 + (1 | GameID), data = df_era)
model_interaction_wl_era <- glmer( #WL MODEL
WL_REG ~ ERA_REG * RRI_CAT +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df_era, family = "binomial")
nobs(model_interaction_diff_era)
