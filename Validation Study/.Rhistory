#Load Required Packages
library(readxl)
library(ggplot2)
library(lme4)
library(performance)
library(arm)
library(car)
library(dplyr)
library(parameters)
library(effectsize)
library(chisq.posthoc.test)
df$GameID <- factor(df$GameID)
#Open Correct Excel File
df <- read_excel("C:/Users/Anthony/Desktop/R/21-24_P1.xlsm", sheet = 1)
#Descriptive Statistics
#mean + SD for WL categories for DVs
df %>%
group_by(WL_REG) %>%
summarise(
Mean = mean(Rest_Interval, na.rm = TRUE),
SD = sd(Rest_Interval, na.rm = TRUE),
N = n()
)
df %>%
group_by(WL_REG) %>%
summarise(
Mean = mean(RRI, na.rm = TRUE),
SD = sd(RRI, na.rm = TRUE),
N = n()
)
df %>%
group_by(WL_REG) %>%
summarise(
Mean = mean(DIFF, na.rm = TRUE),
SD = sd(DIFF, na.rm = TRUE),
N = n()
)
df %>%
group_by(WL_REG) %>%
summarise(
Mean = mean(PF, na.rm = TRUE),
SD = sd(PF, na.rm = TRUE),
N = n()
)
#Independent Samples t-tests with effect sizes
t.test(DIFF ~ WL_REG, data = df)
cohens_d(DIFF ~ WL_REG, data = df)
t.test(PA ~ WL_REG, data = df)
cohens_d(PA ~ WL_REG, data = df)
t.test(PF ~ WL_REG, data = df)
cohens_d(PF ~ WL_REG, data = df)
t.test(Rest_Interval ~ WL_REG, data = df)
cohens_d(Rest_Interval ~ WL_REG, data = df)
t.test(RRI ~ WL_REG, data = df)
cohens_d(RRI ~ WL_REG, data = df)
#Interaction Models
# Season factor
df$Season_factor <- factor(df$Season_factor,
levels = 0:1,
labels = c("2022-23", "2023-24"))
# RRI category factor
df$RRI_cat_factor <- factor(df$RRI_cat_factor,
levels = 0:4,
labels = c("CAT 0", "CAT 1", "CAT 2", "CAT 3", "CAT 4"))
model_interaction_diff <- lmer( #DIFF MODEL
DIFF ~ Season_factor * RRI_cat_factor +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
model_interaction_pf <- lmer( #DIFF MODEL
PF ~ Season_factor * RRI_cat_factor +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
#INT FOR PF WAS SIG, POST HOC
emms_pf <- emmeans(model_interaction_pf, ~RRI_cat_factor | Season_factor, pbkrtest.limit = 4922)
summary(emms_pf)
pairs(emms_pf)
model_interaction_pa <- lmer( #DIFF MODEL
PA ~ Season_factor * RRI_cat_factor +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
model_interaction_wl <- glmer( #WL MODEL
WL_REG ~ Season_factor * RRI_cat_factor +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df,
family = binomial(link = "logit")
)
#Chi-Square tests
table_location_wl <- table(df$LOCATION_BIN, df$WL_REG)
chisq.test(table_location_wl)
stdres_location_wl <- chisq.test(table_location_wl)$stdres
chisq.posthoc.test(table_location_wl, method = "bonferroni")
prop.table(table_location_wl, margin = 1)
table_RRI_wl <- table(df$RRI_CAT, df$WL_REG)
chisq.test(table_RRI_wl)
stdres_RRI_wl <- chisq.test(table_RRI_wl)$stdres
chisq.posthoc.test(table_RRI_wl, method = "bonferroni")
prop.table(table_RRI_wl, margin = 1)
#TESTING ASSUMPTIONS OF MULTILEVEL MODELING
#MULTICOLLINEARITY
#MODEL COLLINEARITY DIAGNOSTICS for IVS
vif(lm(DIFF ~ RRI_D1_Cat_1 + RRI_D2_Cat_2 + RRI_D3_Cat_3 + RRI_D4_Cat4 +
+            LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
+            Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4, data = df))
#LINEARITY FOR LINEAR MODELS (ONLY CONTINUOUS IV IS OPP W/L)
crPlots(lm(DIFF ~ Mean_Centered_OPP_WL, data = df))
title("Linearity Check for DIFF")
crPlots(lm(PA ~ Mean_Centered_OPP_WL, data = df))
title("Linearity Check for PA")
crPlots(lm(PF ~ Mean_Centered_OPP_WL, data = df))
title("Linearity Check for PF")
#LINEARITY OF LOGIT, cannot use box tidwell because of mean_centered WL values, looking for randomness
binnedplot(fitted(model_logit_mixed), resid(model_logit_mixed,type = "pearson"))
#DIFF MODEL and Null for ANOVA
model_diff <- lmer(DIFF ~ RRI_D1_Cat_1 + RRI_D2_Cat_2 + RRI_D3_Cat_3 + RRI_D4_Cat4 +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
null_model_diff <- lmer(DIFF ~ 1 + (1 | GameID), data = df)
#PF MODEL
model_pf <- lmer(PF ~ RRI_D1_Cat_1 + RRI_D2_Cat_2 + RRI_D3_Cat_3 + RRI_D4_Cat4 +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
null_model_pf <- lmer(PF ~ 1 + (1 | GameID), data = df)
#PA MODEL
model_pa <- lmer(PA ~ RRI_D1_Cat_1 + RRI_D2_Cat_2 + RRI_D3_Cat_3 + RRI_D4_Cat4 +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df)
null_model_pa <- lmer(PA ~ 1 + (1 | GameID), data = df)
#W/L LOGISTIC MODEL
model_logit_mixed <- glmer(WL_REG ~ RRI_D1_Cat_1 + RRI_D2_Cat_2 + RRI_D3_Cat_3 + RRI_D4_Cat4 +
LOCATION_BIN + Mean_Centered_OPP_WL + Competitive_Season_REG +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df, family = binomial)
null_model_WL <- glmer(WL_REG ~ 1 + (1 | GameID), data = df, family = binomial)
#Printing DIFF MODEL
anova(null_model_diff, model_diff) #print Chi sq, p, AIC, log likelihood
r2(model_diff) #Print r2
parameters(model_diff) #Output for DIFF model (linear)
#Printing PF MODEL
anova(null_model_pf, model_pf) #print Chi sq, p, AIC, log likelihood
r2(model_pf) #Print r2
parameters(model_pf) #Output for PF model (linear)
#Printing PA MODEL
anova(null_model_pa, model_pa) #print Chi sq, p, AIC, log likelihood
r2(model_pa) #Print r2
parameters(model_pa) #Output for PA model (linear)
#Printing W/L MODEL
anova(null_model_WL, model_logit_mixed, test = "Chisq") #print CHI sq, p, AIC, log likelihood
r2(model_logit_mixed)
parameters(model_logit_mixed, exponentiate = TRUE) #Output for W/L model (logistic)
#TEST NORMALITY
#Get residuals
resid_diff <- resid(model_diff)
resid_pa <- resid(model_pa)
resid_pf <- resid(model_pf)
#QQ Plots
qqnorm(resid_diff,main = "Q-Q Plot of Residuals for DIFF Model")
qqline(resid_diff)
qqnorm(resid_pa, main = "Q-Q Plot of Residuals for PA Model")
qqline(resid_pa)
qqnorm(resid_pf, main = "Q-Q Plot of Residuals for PF Model")
qqline(resid_pf)
#Shapiro-Wilk
shapiro.test(resid_diff)
shapiro.test(resid_pa)
shapiro.test(resid_pf)
# Extract RRI terms from DIFF model
rri_diff <- model_parameters(model_diff) %>%
filter(grepl("RRI_", Parameter)) %>%
mutate(DV = "DIFF")
rri_pf <- model_parameters(model_pf) %>%
filter(grepl("RRI_", Parameter)) %>%
mutate(DV = "PF")
rri_pa <- model_parameters(model_pa) %>%
filter(grepl("RRI_", Parameter)) %>%
mutate(DV = "PA")
rri_wl <- model_parameters(model_logit_mixed, exponentiate = TRUE) %>%
filter(grepl("RRI_", Parameter)) %>%
mutate(DV = "WL")
#SUMMARY TABLE OF ESTIMATES AT 95% CI FOR EACH DV
rri_summary <- bind_rows(rri_diff, rri_pf, rri_pa, rri_wl) %>%
rename(RRI_Category = Parameter,
Estimate = Coefficient) %>%
select(RRI_Category, Estimate, CI_low, CI_high, DV)
#Test significant differences between interaction and regular models
anova(model_diff, model_interaction_diff)
anova(model_pf, model_interaction_pf)
anova(model_pa, model_interaction_pa)
anova(model_interaction_wl,model_logit_mixed)
nobs(model_interaction_diff)
