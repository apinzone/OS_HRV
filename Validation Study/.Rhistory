null_model_pa_era <- lmer(PA ~ 1 + (1 | GameID), data = df_era)
model_interaction_wl_era <- glmer( #WL MODEL
WL_REG ~ ERA_REG * RRI_CAT +
LOCATION_BIN + Mean_Centered_OPP_WL +
Season_Portion_D1_2 + Season_Portion_D2_3 + Season_Portion_D3_4 +
(1 | GameID), data = df_era, family = "binomial")
null_model_wl_era <- glmer(WL_REG ~ 1 + (1 | GameID), data = df_era, family = "binomial")
#TEST NORMALITY
#Get residuals
resid_diff <- resid(model_interaction_diff_era)
resid_pa <- resid(model_interaction_pa_era)
resid_pf <- resid(model_interaction_pa_era)
#QQ Plots
qqnorm(resid_diff,main = "Q-Q Plot of Residuals for DIFF Model")
qqline(resid_diff)
qqnorm(resid_pa, main = "Q-Q Plot of Residuals for PA Model")
qqline(resid_pa)
qqnorm(resid_pf, main = "Q-Q Plot of Residuals for PF Model")
qqline(resid_pf)
#RESULTS FOR MODELS
#DIFF
anova(model_interaction_diff_era, null_model_diff_era)
performance(model_interaction_diff_era)
parameters(model_interaction_diff_era)
results_DIFF <- parameters(model_interaction_diff_era)
#PF
anova(model_interaction_pf_era, null_model_pf_era)
performance(model_interaction_pf_era)
parameters(model_interaction_pf_era)
results_PF <- parameters(model_interaction_pf_era)
#PA
anova(model_interaction_pa_era, null_model_pa_era)
performance(model_interaction_pa_era)
parameters(model_interaction_pa_era)
results_PA <- parameters(model_interaction_pa_era)
#WL
anova(model_interaction_wl_era, null_model_wl_era)
performance(model_interaction_wl_era)
parameters(model_interaction_wl_era, exponentiate = TRUE)
results_WL <- parameters(model_interaction_wl_era, exponentiate = TRUE)
#Aggregate into parsimonious table
results_DIFF$outcome <- "Diff"
results_PA$outcome   <- "PA"
results_PF$outcome   <- "PF"
results_WL$outcome   <- "W/L"
# Combine all
combined_results <- bind_rows(results_DIFF, results_PA, results_PF, results_WL)
#Make Table
final_table <- combined_results %>%
mutate(
Estimate_Type = ifelse(outcome == "W/L", "Odds Ratio", "Coefficient")
) %>%
select(
Outcome = outcome,
Parameter,
Estimate_Type,
Estimate = Coefficient,
`95% CI` = CI,
`p-value` = p
) %>%
arrange(Outcome, Parameter)
#CSV it
write.csv(final_table, "REG TABLE ERA STUDY.csv", row.names = FALSE)
#EMMs
emms_diff <- emmeans(model_interaction_diff_era, ~ ERA_REG | RRI_CAT, pbkrtest.limit = 14516)
emms_pf <- emmeans(model_interaction_pf_era, ~ ERA_REG | RRI_CAT, pbkrtest.limit = 14516)
emms_pa <- emmeans(model_interaction_pa_era, ~ ERA_REG | RRI_CAT, pbkrtest.limit = 14516)
interaction_effect_WL <- ggpredict(model_interaction_wl_era, terms = c("ERA_REG", "RRI_CAT"))
#Plots
emmip(model_interaction_diff_era, ERA_REG ~ RRI_CAT, CIs = TRUE, pbkrtest.limit=14516)
emmip(model_interaction_pf_era, ERA_REG ~ RRI_CAT, CIs = TRUE, pbkrtest.limit=14516)
emmip(model_interaction_pa_era, ERA_REG ~ RRI_CAT, CIs = TRUE, pbkrtest.limit=14516)
plot(interaction_effect_WL)
#Tables
df_diff <- as.data.frame(emms_diff) %>%
select(ERA_REG, RRI_CAT, emmean, lower.CL, upper.CL) %>%
rename(Diff = emmean, Diff_CI_Low = lower.CL, Diff_CI_High = upper.CL)
df_pa <- as.data.frame(emms_pa) %>%
select(ERA_REG, RRI_CAT, emmean, lower.CL, upper.CL) %>%
rename(PA = emmean, PA_CI_Low = lower.CL, PA_CI_High = upper.CL)
df_pf <- as.data.frame(emms_pf) %>%
select(ERA_REG, RRI_CAT, emmean, lower.CL, upper.CL) %>%
rename(PF = emmean, PF_CI_Low = lower.CL, PF_CI_High = upper.CL)
df_combined <- df_diff %>%
left_join(df_pa, by = c("ERA_REG", "RRI_CAT")) %>%
left_join(df_pf, by = c("ERA_REG", "RRI_CAT")) %>%
arrange(ERA_REG, RRI_CAT)
write.csv(df_combined, "linear EMMS Era.csv", row.names = FALSE)
df_export <- interaction_effect_WL %>%
rename(
RRI_CAT = x,
ERA_REG = group,
Predicted_Value = predicted,
CI_Low = conf.low,
CI_High = conf.high
)
write.csv(df_export, "Predicted WL Int.csv", row.names = FALSE)
